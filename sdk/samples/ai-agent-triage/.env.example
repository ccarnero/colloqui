# sdk/samples/ai-agent-triage/.env.example
# Copy to .env in this directory — resolve-env.sh loads it automatically.

# ----- LLM (same knobs as ai-agent-playground) ------------------------------
# The triage agent needs a real online LLM. Pick the provider/model and put
# the matching API key below.
AI_AGENT_PROVIDER=openai
AI_AGENT_MODEL=gpt-4o-mini

# Credential mode:
# - connector: this sample creates/reuses an enabled connector tagged "llm"
#              (default name: sample-<provider>-llm, shared with the
#              ai-agent-playground sample) and sets model_config.llm.connectorId
#              on the agent. Best match for the admin-console UX.
# - env: agent has no connectorId; agent-ai-service must already have provider
#        env vars such as OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.
AI_CREDENTIAL_MODE=connector

# Required only for AI_CREDENTIAL_MODE=connector.
# Pick the key/base URL matching AI_AGENT_PROVIDER.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# Optional connector/agent naming.
# AI_LLM_CONNECTOR_NAME=sample-openai-llm
# AI_AGENT_NAME=ai-sample-triage

# ----- Telegram (optional) ---------------------------------------------------
# Auto-discovered from the bot's recent getUpdates if left unset (setup.sh
# fetches the bot's own token from the platform to do this). Set to pin an
# exact chat_id instead of relying on discovery. A bot cannot cold-message a
# phone number — you must /start it first either way.
TELEGRAM_CHAT_ID=

# Optional second recipient. When set (or discovered), the notify step becomes
# a parallel branch with one channelSend arm per chat.
TELEGRAM_CHAT_ID_2=

# Pin a specific Telegram channel account instead of auto-resolving the first
# active one.
TG_ACCOUNT_ID=

# ----- Sample identity / behavior ---------------------------------------------
# Dedicated HTTP channel instance identity for this sample (the last path
# segment of /api/webhooks/http/<tenant>/<externalId>).
TRIAGE_HTTP_EXTERNAL_ID=ai-agent-triage
TRIAGE_HTTP_ACCOUNT_NAME=AI Agent Triage

# 1 (default) pins the workflow trigger to this sample's own HTTP instance via
# accountIds, so only messages sent to its own ingest URL fire it. 0 lets any
# HTTP message on the tenant trigger it.
TRIAGE_PIN=1

# Chat-id discovery must clear any active Telegram webhook to poll getUpdates
# (telegram-transform-reply registers one). 1 (default) restores that same
# webhook URL afterward; 0 leaves the bot in polling mode.
TRIAGE_RESTORE_WEBHOOK=1
TRIAGE_DISCOVER_WAIT_SECONDS=60
TRIAGE_DISCOVER_POLL_INTERVAL=2

# 1 (default) rebuilds the HTTP instance + workflow from scratch on every run,
# so they always embed the agent id / chat id(s) just resolved. Connector and
# agent are upserted in place regardless. Set to 0 to reuse the existing
# instance/workflow by name instead.
RECREATE=1

# Seconds between the sample messages run.sh posts.
TRIAGE_RUN_DELAY_S=2

# ----- Gateway coordinates (auto-detected by resolve-env.sh; override if needed) ---
# YOIZEN_BASE_URL=
# YOIZEN_HOST_HEADER=
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123
