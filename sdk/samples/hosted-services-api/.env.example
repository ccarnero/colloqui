# Copy to .env and adjust if needed. Loaded automatically by setup.sh and run.sh.
# Gateway/dev defaults are auto-detected by ../lib/resolve-env.sh.

# YOIZEN_BASE_URL=http://localhost:8080
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# Hosted service identity. Name must be lowercase DNS-ish: letters, numbers, hyphens.
HOSTED_SERVICE_NAME=sample-echo
HOSTED_ROUTE_PREFIX=/samples/hosted-echo

# The registry-service creates a Knative Service with runAsNonRoot=1001 and a
# readiness probe on /health. Use an image that can run as UID 1001 and serves
# GET /health on HOSTED_SERVICE_PORT.
HOSTED_SERVICE_IMAGE=ealen/echo-server:latest
HOSTED_SERVICE_PORT=8080

# Scaling defaults.
HOSTED_MIN_SCALE=0
HOSTED_MAX_SCALE=2
HOSTED_CONCURRENCY_TARGET=25

# Route behavior.
HOSTED_ROUTE_PUBLIC=true
HOSTED_ROUTE_STRIP_PREFIX=true
HOSTED_ROUTE_METHODS=GET,POST

# Optional workflow: trigger over a dedicated HTTP channel instance, call the
# hosted service with serviceCall, then send a Telegram message prefixed
# "HOSTED SERVICE SAMPLE" so it is easy to distinguish from other samples.
HOSTED_WORKFLOW_ENABLED=1
HOSTED_WORKFLOW_NAME=hosted-service-telegram
HOSTED_HTTP_EXTERNAL_ID=hosted-services-api

# Required only when HOSTED_WORKFLOW_ENABLED=1.
# TELEGRAM_CHAT_ID=123456789

# Optional: pin a specific Telegram channel account. If omitted, setup.sh uses
# the first active Telegram account in the tenant.
# TG_ACCOUNT_ID=

# Recreate the registered service and route instead of reusing/updating them.
RECREATE=0
