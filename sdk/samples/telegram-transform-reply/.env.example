# Copy to .env and fill in. Loaded automatically by setup.sh.
# Infra (endpoint/host/tenant/creds) is auto-resolved — only secrets go here.

# REQUIRED: bot token from @BotFather (the SEND credential)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# OPTIONAL: public HTTPS base Telegram can reach (e.g. a cloudflared tunnel).
# When set, setup.sh registers the webhook for real inbound.
# TG_PUBLIC_URL=https://api.example.net

# OPTIONAL: drive the chain with a synthetic inbound update (no real message).
# SIMULATE_INBOUND=1

# REQUIRED when SIMULATE_INBOUND=1: your real numeric Telegram chat id.
# The bot must have been started by this chat first, or Telegram rejects the
# reply with "Bad Request: chat not found".
# TELEGRAM_TEST_CHAT_ID=123456789
