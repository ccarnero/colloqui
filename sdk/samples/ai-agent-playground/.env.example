# Gateway/dev defaults are auto-detected by ../lib/resolve-env.sh.
# Override only when needed.
# YOIZEN_BASE_URL=http://localhost:8080
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# Agent identity.
AI_AGENT_NAME=ai-sample-playground
AI_AGENT_PROVIDER=openai
AI_AGENT_MODEL=gpt-4o-mini
AI_AGENT_MESSAGE=Reply with one short sentence confirming the Yoizen AI sample is working.

# Credential mode:
# - connector: this sample creates/reuses an enabled connector tagged "llm" and
#              sets model_config.llm.connectorId on the agent. Best match for
#              the admin-console UX.
# - env: agent has no connectorId; agent-ai-service must already have provider
#        env vars such as OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.
AI_CREDENTIAL_MODE=connector

# Required only for AI_CREDENTIAL_MODE=connector.
# Pick the key/base URL for AI_AGENT_PROVIDER.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# Optional connector naming/behavior.
AI_LLM_CONNECTOR_NAME=sample-openai-llm
RECREATE=0
POLL_TIMEOUT_S=90
