# ai-call-center-supervisor — copy to .env and adjust.
# ../lib/resolve-env.sh loads this file automatically from setup.sh / run.sh.

# --- LLM (required unless AI_CREDENTIAL_MODE=env) -----------------------------
# Real provider key for the triage agent's LLM connector.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_CREDENTIAL_MODE=connector        # connector (default) | env
# AI_AGENT_PROVIDER=openai            # openai | anthropic | google | groq | mistral | cohere | openrouter | xai | ollama | deepseek
# AI_AGENT_MODEL=gpt-4o-mini
# AI_AGENT_NAME=ai-sample-supervisor
# AI_LLM_CONNECTOR_NAME=sample-openai-llm   # reused if it already exists (ai-agent-playground creates the same one)

# --- Hosted mock-CRM service ---------------------------------------------------
# CRM_SERVICE_NAME=sample-crm
# CRM_SERVICE_IMAGE=ealen/echo-server:latest   # must run as UID 1001 and serve /health
# CRM_SERVICE_PORT=8080
# CRM_MIN_SCALE=0
# CRM_MAX_SCALE=2
# CRM_CONCURRENCY_TARGET=25
# CRM_READY_TIMEOUT_S=120

# --- Telegram escalation ---------------------------------------------------------
# Supervisor chat id — auto-discovered from the bot's recent /start messages
# if left unset. Set it to pin an exact chat.
# TELEGRAM_CHAT_ID=111222333
# TG_ACCOUNT_ID=                        # pin a specific Telegram channel account
# SUPERVISOR_RESTORE_WEBHOOK=1          # restore the bot webhook after chat discovery
# SUPERVISOR_DISCOVER_WAIT_SECONDS=60
# SUPERVISOR_DISCOVER_POLL_INTERVAL=2

# --- Workflow / HTTP instance -----------------------------------------------------
# SUPERVISOR_WORKFLOW_NAME=ai-call-center-supervisor
# SUPERVISOR_HTTP_EXTERNAL_ID=ai-call-center-supervisor
# SUPERVISOR_HTTP_ACCOUNT_NAME=AI Call Center Supervisor
# SUPERVISOR_PIN=1                      # 1 pins the trigger to this sample's own HTTP instance
# RECREATE=0                            # 1 deletes + rebuilds service/agent/instance/workflow

# --- Gateway / tenant (resolved automatically; override only if needed) ------------
# YOIZEN_BASE_URL=http://localhost:8080
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# --- run.sh knobs ---------------------------------------------------------------------
# SUPERVISOR_RUN_TEXT_ANGRY=third time my bill is wrong, I want a $200 refund or I cancel
# SUPERVISOR_RUN_TEXT_CALM=how do I update my email address?
# SUPERVISOR_RUN_PAUSE_SECONDS=3
