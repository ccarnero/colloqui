# Copy to .env and fill in. Loaded automatically by run.sh.
# Infra (endpoint/host/tenant/creds) is auto-resolved — only secrets go here.

# REQUIRED: your numeric Telegram chat id (DM the bot first; @userinfobot tells you).
TELEGRAM_CHAT_ID=123456789

# OPTIONAL: provide the bot token so run.sh also provisions the telegram account
# (otherwise it assumes an active telegram account already exists).
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
