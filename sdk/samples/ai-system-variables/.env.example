# sdk/samples/ai-system-variables/.env.example
# Copy to .env in this directory — resolve-env.sh loads it automatically.

# ----- The three system variables (create-only defaults) ---------------------
# Used ONLY when the variable does not exist yet. Existing values are
# preserved across setup re-runs so a live PATCH survives; SYSVARS_RESET=1
# forces them back to these values.
SYSVARS_COMPANY_NAME=Acme Telco
SYSVARS_ESCALATION_PRIORITY=high
SYSVARS_BRAND_VOICE=warm and upbeat, always thanking the customer
SYSVARS_RESET=0

# ----- LLM (same knobs as ai-agent-triage) ------------------------------------
AI_AGENT_PROVIDER=openai
AI_AGENT_MODEL=gpt-4o-mini

# Credential mode:
# - connector: this sample creates/reuses an enabled connector tagged "llm"
#              (default name: sample-<provider>-llm, shared with the other AI
#              samples) and sets model_config.llm.connectorId on the agent.
# - env: agent has no connectorId; agent-ai-service must already have provider
#        env vars such as OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.
AI_CREDENTIAL_MODE=connector

# Required only for AI_CREDENTIAL_MODE=connector.
# Pick the key/base URL matching AI_AGENT_PROVIDER.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...

# Optional connector/agent naming.
# AI_LLM_CONNECTOR_NAME=sample-openai-llm
# AI_AGENT_NAME=ai-sample-sysvars

# ----- Telegram (optional) -----------------------------------------------------
# Auto-discovered from the bot's recent getUpdates ONLY when left unset (a
# preset value skips discovery and its webhook clear/restore entirely). A bot
# cannot cold-message a phone number — you must /start it first either way.
TELEGRAM_CHAT_ID=

# Pin a specific Telegram channel account instead of auto-resolving the first
# active one.
TG_ACCOUNT_ID=

# ----- Sample identity / behavior -----------------------------------------------
# Dedicated HTTP channel instance identity for this sample (the last path
# segment of /api/webhooks/http/<tenant>/<externalId>).
SYSVARS_HTTP_EXTERNAL_ID=ai-system-variables
SYSVARS_HTTP_ACCOUNT_NAME=AI System Variables

# 1 (default) pins the workflow trigger to this sample's own HTTP instance via
# accountIds, so only messages sent to its own ingest URL fire it. 0 lets any
# HTTP message on the tenant trigger it.
SYSVARS_PIN=1

# Chat-id discovery must clear any active Telegram webhook to poll getUpdates
# (telegram-transform-reply registers one). 1 (default) restores that same
# webhook URL afterward; 0 leaves the bot in polling mode.
SYSVARS_RESTORE_WEBHOOK=1
SYSVARS_DISCOVER_WAIT_SECONDS=60
SYSVARS_DISCOVER_POLL_INTERVAL=2

# 1 (default) rebuilds the HTTP instance + workflow from scratch on every run,
# so they always embed the agent id / chat id just resolved. Variables,
# connector and agent are upserted in place regardless. Set to 0 to reuse the
# existing instance/workflow by name instead.
RECREATE=1

# Seconds between the sample messages run.sh posts.
SYSVARS_RUN_DELAY_S=2

# ----- Gateway coordinates (auto-detected by resolve-env.sh; override if needed) ---
# YOIZEN_BASE_URL=
# YOIZEN_HOST_HEADER=
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123
