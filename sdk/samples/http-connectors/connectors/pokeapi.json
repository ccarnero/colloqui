{
  "name": "pokeapi",
  "context": "external",
  "baseUrl": "https://pokeapi.co",
  "authType": "none",
  "authConfig": {},
  "timeoutMs": 10000,
  "maxRetries": 2,
  "retryBackoffMs": 300,
  "healthCheckPath": "/api/v2/pokemon/ditto",
  "tags": ["sample", "public", "no-auth"],
  "endpoints": [
    { "label": "Get Pokemon by name or id", "method": "GET", "path": "/api/v2/pokemon/ditto" },
    { "label": "List Pokemon (paginated)", "method": "GET", "path": "/api/v2/pokemon" },
    { "label": "Get ability by name or id", "method": "GET", "path": "/api/v2/ability/limber" },
    { "label": "Get type by name or id", "method": "GET", "path": "/api/v2/type/water" },
    { "label": "Get move by name or id", "method": "GET", "path": "/api/v2/move/tackle" },
    { "label": "Get generation by name or id", "method": "GET", "path": "/api/v2/generation/generation-i" }
  ]
}
