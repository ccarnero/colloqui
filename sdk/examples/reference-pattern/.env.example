# sdk/samples/http-bridge/.env.example
# Copy to .env in this directory — resolve-env.sh loads it automatically.

# ----- Optional -----------------------------------------------------------
# Both chat ids are auto-discovered from the bot's recent getUpdates if left
# unset (setup.sh fetches the bot's own token from the platform to do this).
# Set either one to pin an exact chat_id instead of relying on discovery.
# A bot cannot cold-message a phone number — the recipient(s) must /start it
# first regardless of whether the id is pinned or discovered.
TELEGRAM_CHAT_ID=

# Second recipient's numeric chat id. The notify step is ALWAYS a branch
# (two recipients) regardless of this being set — if left empty and not
# auto-discovered, the second arm just falls back to TELEGRAM_CHAT_ID (both
# arms send to the same chat) until you swap in the real id via the UI.
TELEGRAM_CHAT_ID_2=

# Pin a specific Telegram channel account instead of auto-resolving the first
# active one.
TG_ACCOUNT_ID=

# Dedicated HTTP channel instance identity for this sample (the last path
# segment of /api/webhooks/http/<tenant>/<externalId>).
BRIDGE_HTTP_EXTERNAL_ID=http-bridge
BRIDGE_HTTP_ACCOUNT_NAME=HTTP Bridge

# 1 (default) pins the workflow trigger to this sample's own HTTP instance via
# accountIds, so only messages sent to its own ingest URL fire it. 0 lets any
# HTTP message on the tenant trigger it.
BRIDGE_PIN=1

# Chat-id discovery must clear any active Telegram webhook to poll getUpdates
# (telegram-transform-reply registers one). 1 (default) restores that same
# webhook URL afterward; 0 leaves the bot in polling mode.
BRIDGE_RESTORE_WEBHOOK=1

# When a webhook was active, old messages (even ones sent before this run)
# don't replay via getUpdates once it's cleared. Discovery blocks with an
# interactive "press Enter once everyone has messaged the bot" prompt, capped
# at this many seconds (falls back to a plain sleep of the same length in
# non-interactive shells). BRIDGE_DISCOVER_POLL_INTERVAL is the retry gap
# used afterward to absorb Telegram's own delivery lag.
BRIDGE_DISCOVER_WAIT_SECONDS=60
BRIDGE_DISCOVER_POLL_INTERVAL=2

# 1 (default) rebuilds the HTTP instance + workflow from scratch on every run,
# so it always picks up whatever chat_ids were just resolved. Set to 0 to
# reuse an existing workflow/instance by name instead.
RECREATE=1

# ----- Gateway coordinates (auto-detected by resolve-env.sh; override if needed) ---
# YOIZEN_BASE_URL=
# YOIZEN_HOST_HEADER=
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123
