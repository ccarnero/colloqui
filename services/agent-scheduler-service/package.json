{
  "name": "agent-scheduler-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run dist/main.js",
    "start:dev": "bun run --watch src/main.ts",
    "test": "bun test --preload ./test/preload-env.ts",
    "test:unit": "bun test --preload ./test/preload-env.ts test/unit",
    "test:integration": "bun test --preload ./test/preload-env.ts test/integration",
    "test:e2e": "bun test --preload ./test/preload-env.ts test/e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.2.2",
    "@yoizen/database": "workspace:*",
    "@yoizen/observability": "workspace:*",
    "@yoizen/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.4.1",
    "nats": "^2.29.3",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "toad-scheduler": "^4.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}