{
  "name": "agent-ai-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run dist/main.js",
    "start:dev": "bun run --watch src/main.ts",
    "test": "bun test --preload ./test/preload-env.ts",
    "test:unit": "bun test --preload ./test/preload-env.ts test/unit",
    "test:integration": "bun test --preload ./test/preload-env.ts test/integration",
    "test:e2e": "bun test --preload ./test/preload-env.ts test/e2e"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/mcp": "^1.0.46",
    "@ai-sdk/openai": "^3.0.68",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@yoizen/database": "file:../../packages/database",
    "@yoizen/observability": "file:../../packages/observability",
    "@yoizen/shared": "file:../../packages/shared",
    "ai": "^6.0.197",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron-parser": "^5.5.0",
    "ioredis": "^5.4.1",
    "nats": "^2.29.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "typescript": "^5.7.2"
  }
}
