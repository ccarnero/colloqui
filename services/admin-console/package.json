{
  "name": "admin-console",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:clusterwin": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-cluster.ps1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:shared": "node ../../packages/angular-shared/scripts/build-lib.mjs",
    "postinstall": "pnpm run build:shared && pnpm exec patch-package",
    "prebuild": "pnpm run build:shared",
    "prewatch": "pnpm run build:shared",
    "prestart": "pnpm run build:shared",
    "pretest": "pnpm run build:shared"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.3",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.3",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@foblex/flow": "18.6.0",
    "@yoizen/angular-shared": "workspace:*",
    "monaco-editor": "^0.55.1",
    "ngx-monaco-editor-v2": "^21.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.2"
  }
}
