# integrations/ai/ai-agent-triage/.env.example
# Copy to .env in this directory — ../../lib/resolve-env.sh (sourced by run.sh)
# loads it automatically.

# Provisioning is now declarative — see manifest.yaml + README.md's
# "Provision (declarative)" section. Editing the LLM provider/model,
# connector, Telegram recipient (systemVariables), or workflow shape happens
# in manifest.yaml, NOT via env vars (the vars below only affect
# run.sh/src/index.ts's read-only driver, which posts sample messages
# through the already-provisioned instance — it never creates or modifies
# platform objects).

# The secret VALUE for the LLM connector's bearer auth, read verbatim by
# --secrets-from-env (the binding name IS the env var name, no transform).
# OPENAI_API_KEY=sk-...   <- REMINDER ONLY: --secrets-from-env reads the value
# from the BINDING name, so putting this here does nothing for `apply`. Remap it
# on the apply line:  env "<binding-name>=<your key>" yoizen manifests apply
# ... --secrets-from-env   (binding names are in README.md § Secrets).

# ----- Names run.sh/src/index.ts look up (must match manifest.yaml if overridden) ---
TRIAGE_WORKFLOW_NAME=ai-agent-triage
TRIAGE_HTTP_EXTERNAL_ID=manifest:ai-agent-triage

# Seconds between the sample messages run.sh posts.
TRIAGE_RUN_DELAY_S=2

# ----- Gateway coordinates (auto-detected by resolve-env.sh; override if needed) ---
# YOIZEN_BASE_URL=
# YOIZEN_HOST_HEADER=
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123
