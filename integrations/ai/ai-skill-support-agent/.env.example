# ai-skill-support-agent — copy to .env and adjust.
# Gateway/dev defaults are auto-detected by ../lib/resolve-env.sh.
# YOIZEN_BASE_URL=http://localhost:8080
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# Agent LLM. Connector mode matches the admin-console LLM Connector field.
AI_AGENT_PROVIDER=openai
AI_AGENT_MODEL=gpt-4o-mini
AI_CREDENTIAL_MODE=connector
# AI_LLM_CONNECTOR_NAME=sample-openai-llm   # override; default is sample-<provider>-llm
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Knowledge-base ingestion/search currently uses OpenAI embeddings.
# The upload worker can use the connector created by this sample, but runtime
# KB search in agent-ai-service still needs OPENAI_API_KEY in that service env.
KB_EMBEDDING_MODEL=text-embedding-3-small

AI_SKILL_NAME=refund-policy-expert
KB_NAME=ai-sample-callcenter-kb
AI_AGENT_NAME=ai-sample-support
RECREATE=0
POLL_TIMEOUT_S=120
DOC_TIMEOUT_S=120
