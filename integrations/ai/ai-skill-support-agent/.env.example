# ai-skill-support-agent — copy to .env and adjust.
# Provisioning is DECLARATIVE now (manifest.yaml + `yoizen manifests apply`,
# see README.md) — there is no setup script and no per-run provisioning env.
# These vars only affect run.sh (src/index.ts), the read-only driver.
# Gateway/dev defaults are auto-detected by ../lib/resolve-env.sh.
# YOIZEN_BASE_URL=http://localhost:8080
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# Agent name — must match manifest.yaml's agent (spec.agents[0].name).
AI_AGENT_NAME=ai-sample-support

# Runtime execution poll timeout (seconds).
POLL_TIMEOUT_S=120
