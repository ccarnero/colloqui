# Gateway/dev defaults are auto-detected by ../lib/resolve-env.sh.
# Override only when needed.
# YOIZEN_BASE_URL=http://localhost:8080
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# Provisioning is now declarative — see manifest.yaml + README.md's
# "Provision (declarative)" section. Editing the agent's provider/model,
# connector, or profile happens in manifest.yaml, NOT via env vars (the vars
# below only affect run.sh/src/index.ts's read-only execution driver, which
# just LOOKS UP the agent by name and submits/polls one runtime execution —
# it never creates or modifies platform objects).

# Name run.sh/src/index.ts looks up (must match manifest.yaml if overridden).
AI_AGENT_NAME=ai-sample-playground
AI_AGENT_MESSAGE=Reply with one short sentence confirming the Yoizen AI sample is working.
POLL_TIMEOUT_S=90

# The secret VALUE for the LLM connector's bearer auth, read verbatim by
# --secrets-from-env (the binding name IS the env var name, no transform).
# OPENAI_API_KEY=sk-...   <- REMINDER ONLY: --secrets-from-env reads the value
# from the BINDING name, so putting this here does nothing for `apply`. Remap it
# on the apply line:  env "<binding-name>=<your key>" yoizen manifests apply
# ... --secrets-from-env   (binding names are in README.md § Secrets).
