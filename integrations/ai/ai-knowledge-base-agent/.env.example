# Gateway/dev defaults are auto-detected by ../lib/resolve-env.sh.
# YOIZEN_BASE_URL=http://localhost:8080
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# Provisioning is now declarative — see manifest.yaml + README.md's
# "Provision (declarative)" section. Editing the LLM/embedding connector, the
# knowledge base's ingestion_config, the FAQ document content, or the agent's
# profile happens in manifest.yaml, NOT via env vars (the vars below only
# affect run.sh/src/index.ts's read-only driver, which resolves the agent by
# name and asks it one KB-backed question — it never creates or modifies
# platform objects).

# The secret VALUE for the LLM/embedding connector's bearer auth, read
# verbatim by --secrets-from-env (the binding name IS the env var name, no
# transform).
# OPENAI_API_KEY=sk-...

# Name/message run.sh/src/index.ts looks up (must match manifest.yaml if overridden).
AI_AGENT_NAME=ai-sample-kb-agent
AI_AGENT_MESSAGE=According to the support FAQ, what is the refund policy? Include the verification phrase if you see one.
POLL_TIMEOUT_S=120
