# Copy to .env and fill in. Loaded automatically by setup.sh / run.sh.
#
# NOTE: this file is named `env.example` (NO leading dot). A sandbox restriction
# prevents writing `.env.*` files in this environment, so the shipped template
# drops the dot. Rename it to `.env` when you copy it:
#
#     cp env.example .env    # then edit
#
# Infra (endpoint/host/tenant/creds) is auto-resolved by ../lib/resolve-env.sh —
# only secrets and overrides go here.

# =============================================================================
# The repo this bot answers questions about (DeepWiki indexes "owner/name").
# =============================================================================
REPO_NAME=vercel/next.js

# =============================================================================
# LLM credentials for the two agents (triage + summarizer).
# Same knobs as ../../ai/ai-agent-triage / ../../ai/ai-agent-playground.
# =============================================================================
# connector (default) → this script creates an LLM connector from the API key
# below. env → assume agent-ai-service already has the provider key in its env.
AI_CREDENTIAL_MODE=connector
AI_AGENT_PROVIDER=openai
AI_AGENT_MODEL=gpt-4o-mini
# REQUIRED for AI_CREDENTIAL_MODE=connector (name matches your provider):
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# =============================================================================
# DeepWiki MCP server (public, no auth). A PUBLIC server is REQUIRED — the
# platform's SSRF guard blocks localhost/RFC1918 targets, so a locally hosted
# MCP server will not work for the mcpCall step.
#
# DeepWiki's real tools: read_wiki_structure, read_wiki_contents, ask_question.
# This bot uses ask_question.
# =============================================================================
# DEEPWIKI_SERVER_NAME=deepwiki
# DEEPWIKI_URL=https://mcp.deepwiki.com/mcp
# DEEPWIKI_TOOL=ask_question

# =============================================================================
# Telegram bot (the SEND credential). From @BotFather.
# Without it, artifacts still provision and the workflow still EXECUTES
# (observable via SIMULATE_INBOUND), but the outbound reply returns 404.
# =============================================================================
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Public HTTPS base Telegram can reach (e.g. a cloudflared tunnel). When set +
# a real token, setup registers the webhook so REAL inbound messages fire the bot.
# TG_PUBLIC_URL=https://api.devmachina.net

# =============================================================================
# Synthetic drive (run.sh defaults SIMULATE_INBOUND=1). Posts a signed fake
# inbound update to the webhook ingest endpoint and polls for the execution —
# this is what makes the sample runnable WITHOUT a live Telegram bot.
# =============================================================================
# SIMULATE_INBOUND=1
# SIMULATE_TEXT=How does routing work in vercel/next.js?
# TELEGRAM_TEST_CHAT_ID=999999999   # any number for observe-only; a real chat
#                                   # that /start-ed the bot for real delivery.

# =============================================================================
# Naming + lifecycle.
# =============================================================================
# TRIAGE_AGENT_NAME=repo-support-triage
# SUMMARIZER_AGENT_NAME=repo-support-summarizer
# WORKFLOW_NAME=mcp-repo-support-bot
# TG_EXTERNAL_ID=repo-support-bot
# TG_ACCOUNT_NAME=Repo Support Bot

# Set to 1 to delete + re-provision this sample's own workflow, agents, and MCP
# server (by name) before setup. Also rotates the Telegram account/secret.
RECREATE=0

# =============================================================================
# Server-side feature flags (set on the SERVICES, not here — listed for
# reference). The mcpCall workflow action does NOT require any flag: it runs on
# connector-runtime independently of agent-side tool filtering. In particular,
# AGENT_MCP_TOOL_FILTERING_ENABLED gates per-tool filtering on the AGENT side
# only — it is NOT needed for this sample's workflow mcpCall step.
# =============================================================================
