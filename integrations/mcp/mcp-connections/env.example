# Gateway/dev defaults are auto-detected by ../lib/resolve-env.sh.
# Override only when needed.
# YOIZEN_BASE_URL=http://api-gateway.platform-services-dev.dev.local
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# Provisioning is now declarative — see manifest.yaml + README.md's
# "Provision (declarative)" section. Editing the MCP server url, auth,
# sample tools, or agent/workflow bodies happens in manifest.yaml, NOT via
# env vars (the vars below only affect run.sh/src/index.ts's read-only
# verification driver, which just LOOKS UP resources by name — it never
# creates or modifies them).
#
# Names run.sh/src/index.ts look up (must match manifest.yaml if overridden):
MCP_SERVER_NAME=sample-mcp-server
MCP_AGENT_NAME=mcp-connections-demo-agent
MCP_WORKFLOW_NAME=mcp-connections-demo

# The secret VALUE for the mcp server's bearer auth, read verbatim by
# `--secrets-from-env` (the binding name IS the env var name — no transform).
# The endpoint is fake/unreachable by design, so ANY non-empty value works
# for this demo — it is never actually checked by a real server.
# mcp-connections-bearer-token=any-non-empty-value
