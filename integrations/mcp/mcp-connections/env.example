# Gateway/dev defaults are auto-detected by ../lib/resolve-env.sh.
# Override only when needed.
# YOIZEN_BASE_URL=http://api-gateway.platform-services-dev.dev.local
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# MCP server to register. Defaults point at a fake endpoint so the sample can
# demonstrate the SDK calls even without a reachable server (test-connection
# and tool discovery then report expected warnings).
#
# For a REAL end-to-end run, point at a public no-auth MCP server, e.g.:
#   MCP_SERVER_URL=https://mcp.deepwiki.com/mcp
# Note: the platform's SSRF guard blocks localhost/RFC1918 URLs — use a
# public endpoint, not a locally hosted one.
MCP_SERVER_NAME=sample-mcp-server
# MCP_SERVER_URL=https://mcp.deepwiki.com/mcp
# MCP_SERVER_DESCRIPTION=Sample MCP server registered by the SDK sample

# Bearer token sent as the server's auth_config. Public servers like DeepWiki
# need none — leave unset for authType to still demonstrate the shape.
# MCP_AUTH_TOKEN=replace-with-a-real-token

# Per-agent tool enablement (comma-separated tool names). With DeepWiki use
# its real tools, e.g.:
#   MCP_SAMPLE_TOOLS=read_wiki_structure,ask_question
# MCP_SAMPLE_TOOLS=search,lookup
# MCP_TOOL_DESCRIPTION_OVERRIDE=Use this tool first for any repository question.

# Demo agent + workflow naming.
MCP_AGENT_NAME=mcp-connections-demo-agent
# MCP_AGENT_DESCRIPTION=Demo agent for the MCP connections sample
MCP_WORKFLOW_NAME=mcp-connections-demo-workflow
# MCP_APPLICATION=mcp-connections-sample

# Set to 1 to delete and re-provision this sample's own MCP server, agent and
# workflow (by name) before setup.
RECREATE=0

# Server-side feature flags this sample interacts with (set on the SERVICES,
# not here — listed for reference):
# - AGENT_TOOL_DESCRIPTION_OVERRIDES_ENABLED=true on agent-admin-service
#   (required for the description-override step; otherwise it is skipped
#   with a warning) and on agent-ai-service (to apply overrides at runtime).
# - AGENT_MCP_TOOL_FILTERING_ENABLED=true on agent-ai-service (required for
#   the per-tool enablement to take effect at runtime).
