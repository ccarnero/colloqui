# Copy to .env and adjust if needed. Loaded automatically by run.sh.
# Provisioning is declarative now (manifest.yaml + `yoizen manifests apply`)
# — the hosted service, route, workflow, and Telegram recipient chat id
# (systemVariables) all live in manifest.yaml, not here. See README.md.
# Gateway/dev defaults are auto-detected by ../lib/resolve-env.sh.

# YOIZEN_BASE_URL=http://localhost:8080
# YOIZEN_HOST_HEADER=api-gateway.platform-services-dev.dev.local
# YOIZEN_TENANT=acme
# YOIZEN_EMAIL=yclawd@demo.io
# YOIZEN_PASSWORD=admin123

# OPTIONAL: overrides for run.sh's exercise driver (defaults match manifest.yaml).
# HOSTED_SERVICE_NAME=sample-echo
# HOSTED_ROUTE_PREFIX=/samples/hosted-echo
# HOSTED_ROUTE_CACHE_WAIT_SECONDS=16
# HOSTED_WORKFLOW_NAME=hosted-service-telegram
# HOSTED_HTTP_EXTERNAL_ID=manifest:hosted-services-api
# RUN_TEXT=hello hosted service workflow
