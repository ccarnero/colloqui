# Copy to .env and fill in. Loaded automatically by run.sh (which sources
# ../../lib/resolve-env.sh). There is no setup.sh here any more — provisioning
# is declarative: yoizen manifests apply -f manifest.yaml --secrets-from-env.
# Infra (endpoint/host/tenant/creds) is auto-resolved — only secrets go here.

# The SEND credential (from @BotFather). NOTE: run.sh does NOT use it — the
# token reaches the account only at apply time, as the manifest binding
# `telegram-bot-token`:  env "telegram-bot-token=<your token>" yoizen
# manifests apply -f manifest.yaml --secrets-from-env. Kept here only so one
# .env can feed that command line.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# UNUSED by this sample now (no setup.sh): a public HTTPS base for Telegram.
# channel-service self-registers the webhook on account creation from
# CHANNEL_SERVICE_PUBLIC_URL; the manual fallback is a setWebhook call —
# see README.md § Run / exercise.
TG_PUBLIC_URL=https://api.devmachina.net

# NOTE: src/index.ts has no SIMULATE_INBOUND switch — run.sh ALWAYS injects a
# synthetic inbound update, and it needs the two vars below.
# (the old SIMULATE_INBOUND=1 knob no longer exists)

# REQUIRED (TELEGRAM_WEBHOOK_SECRET too — the account appSecret, read from
# GET /api/channels/accounts after apply — the gateway prefixes every route
# with /api, so src/index.ts and run.sh log lines that say "/channels/accounts"
# mean the same endpoint; TG_EXTERNAL_ID / TG_WORKFLOW_NAME /
# TG_POLL_TIMEOUT_S are optional overrides, see README.md § Environment).
# Your real numeric Telegram chat id:
# The bot must have been started by this chat first, or Telegram rejects the
# reply with "Bad Request: chat not found".
# TELEGRAM_TEST_CHAT_ID=123456789
# TELEGRAM_WEBHOOK_SECRET=   # the account appSecret; run.sh fails fast without it
