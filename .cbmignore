dist/
build/
coverage/
*.tsbuildinfo

# lockfiles (huge, no symbols to index)
pnpm-lock.yaml
bun.lock
*.lock

# local caches / agent scratch
.turbo/
.codegraph/
.atl/
.claude/worktrees/
.opencode/
