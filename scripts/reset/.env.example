# scripts/reset/.env.example — every var the scripts/reset/*.sh and
# reset-dev.ts read. Copy to `scripts/reset/.env` (gitignored) and fill in
# real dev-cluster values; every script in this folder auto-loads that file
# if present.

# ---------------------------------------------------------------------------
# reset-dev.ts — required stages
# ---------------------------------------------------------------------------

# JetStream connection URL used to purge INGRESS-*/DLQ-*/GATEWAY_AUDIT/
# PLATFORM_TENANTS streams and PAYLOAD-<tenant> claim-check buckets.
NATS_URL=nats://nats.support-services-dev.svc.cluster.local:4222

# Platform/catalog Postgres DB (tenants registry + canary_deployments + the
# tracking.tracked_events table used by reset-tenant.sh).
POSTGRES_HOST=postgres.support-services-dev.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_USER=yoizen
POSTGRES_PASSWORD=yoizen-dev-password
POSTGRES_DB=yoizen

# Shared CNPG cluster hosting one Postgres DB per tenant (tenant_<id>).
TENANT_POSTGRES_SHARED_HOST=postgres-shared-rw.support-services-dev.svc.cluster.local
TENANT_POSTGRES_SHARED_PORT=5432
# Do NOT set TENANT_POSTGRES_SHARED_USER. Tenant tables are owned by
# per-tenant roles (tenant_<id>_app); when this is unset,
# TenantConnectionManager derives the correct role per tenant. Forcing a
# fixed user (e.g. yoizen) causes "permission denied for table events".
# TENANT_POSTGRES_SHARED_USER=
# TENANT_POSTGRES_SHARED_PASSWORD=

# ---------------------------------------------------------------------------
# reset-dev.ts — optional Mongo stage (skipped with a logged reason if unset;
# this cluster is currently Postgres-only, so leave these unset/commented)
# ---------------------------------------------------------------------------

# MONGO_HOST=
# MONGO_PORT=27017
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_DB=
# TENANT_MONGO_SHARED_HOST=
# TENANT_MONGO_SHARED_PORT=27017
# TENANT_MONGO_SHARED_USER=
# TENANT_MONGO_SHARED_PASSWORD=

# ---------------------------------------------------------------------------
# reset-dev.ts — optional usage-aggregator Timescale DB stage (skipped with a
# logged reason if any of these five are unset)
# ---------------------------------------------------------------------------

USAGE_POSTGRES_HOST=postgres-usage-shared-rw.support-services-dev.svc.cluster.local
USAGE_POSTGRES_PORT=5432
USAGE_POSTGRES_USER=yoizen
USAGE_POSTGRES_PASSWORD=yoizen-dev-password
USAGE_POSTGRES_DB=yoizen_usage

# ---------------------------------------------------------------------------
# reset-dev.ts — Redis stage
# ---------------------------------------------------------------------------

REDIS_HOST=redis.support-services-dev.svc.cluster.local
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# reset-tenant.sh / reset-all.sh — kubectl-exec based tenant/tracking wipe
# ---------------------------------------------------------------------------

# kubectl context to use for all `kubectl exec` calls.
KUBECTL_CONTEXT=orbstack
# Namespace where postgres-shared / postgres-0 pods live.
RESET_NAMESPACE=support-services-dev
# Tenant to wipe (matches the tenant_<name> database naming convention).
TENANT=acme
# CNPG primary pod hosting the per-tenant databases (tenant_<name>).
TENANT_POSTGRES_SHARED_POD=postgres-shared-1
# Postgres role used inside that pod (local peer-auth superuser).
TENANT_POSTGRES_SHARED_PG_USER=postgres
# Platform/catalog Postgres pod hosting tracking.tracked_events.
TRACKING_POSTGRES_POD=postgres-0
# App role + DB used for the tracking.tracked_events TRUNCATE.
TRACKING_POSTGRES_USER=yoizen
TRACKING_POSTGRES_DB=yoizen
