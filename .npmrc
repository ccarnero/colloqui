# pnpm security policies for platform-cluster monorepo

# Strict peer dependency resolution — fail if peers aren't satisfied
strict-peer-dependencies=true

# Auto-install peer deps so devs don't forget
auto-install-peers=true

# Audit severity threshold — fail CI on moderate+ vulnerabilities
audit-level=moderate

# Prevent accidental publishing from this private monorepo
package-manager-strict-version=true
manage-package-manager-versions=false

# Strict engine checking
engine-strict=true
