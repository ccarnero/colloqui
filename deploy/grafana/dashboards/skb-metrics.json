          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "title": "Ingestion Latency",
      "type": "heatmap"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
