        "yAxis": { "decimals": 0, "unit": "ms" }
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(skb_ingestion_duration_ms_bucket[$__rate_interval])) by (le)",
