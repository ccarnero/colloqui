# crm-support-telegram demo — example environment file.
# Copy to `.env` and fill in real values; `.env` is git-ignored, never commit
# real tokens. YOIZEN_* platform credentials are NOT listed here — they are
# sourced from the sibling SDK sample `.env` files (see README.md "Running
# the numbered scripts").

# HubSpot account Service Key (Development > Keys > Service keys, object
# scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write,
# crm.objects.tickets.read/write, crm.schemas.contacts.read/write). A legacy
# private-app token is an equally free, interchangeable Bearer-token fallback.
HUBSPOT_SERVICE_KEY=

# Bot token for the customer-facing Telegram channel (from @BotFather).
TELEGRAM_BOT_TOKEN=

# Chat id used by test/demo scripts to simulate a customer message. Leave
# unset to auto-discover on first run (DM the bot, then re-run).
TELEGRAM_TEST_CHAT_ID=

# Backing model for the AI agent leading the support conversation.
OPENAI_API_KEY=

# Public URL (e.g. cloudflared tunnel) the Telegram webhook and async-invoke
# webhook callback are reachable at.
TG_PUBLIC_URL=
