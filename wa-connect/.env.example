# MongoDB
MONGODB_URI=mongodb://localhost:27017/wa-connect

# Meta WhatsApp Cloud API
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_CONFIG_ID=your_embedded_signup_config_id
META_VERIFY_TOKEN=your_custom_webhook_verify_token
META_API_VERSION=v22.0

# For sandbox testing (test phone number)
META_PHONE_NUMBER_ID=your_phone_number_id
META_ACCESS_TOKEN=your_access_token
META_WABA_ID=your_waba_id

# Auth
JWT_SECRET=change_me_to_a_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=6666
NODE_ENV=development

# Testing mode — skips Meta signature verification, uses mock API responses
LOCAL_TESTING=true
